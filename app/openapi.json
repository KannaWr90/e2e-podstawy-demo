{
  "openapi": "3.1.0",
  "info": {
    "title": "Namssor API",
    "version": "1.0.0",
    "description": "REST API fikcyjnej drogerii Namssor (aplikacja szkoleniowa). Logowanie: POST /api/login zwraca token; wysyłaj go w nagłówku Authorization: Bearer <token>. Działa też ciasteczko sid ustawiane przy logowaniu. Błędy: 400 { error, errors: [{ field, message }] }, 401/403/404/409/503 { error }."
  },
  "servers": [{ "url": "http://localhost:4100" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Czy aplikacja działa",
        "security": [],
        "responses": {
          "200": { "description": "Aplikacja działa", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Logowanie, zwraca token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Zalogowano", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Dane zalogowanego użytkownika",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Użytkownik", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Lista produktów",
        "security": [],
        "parameters": [
          { "name": "q", "in": "query", "description": "Fragment nazwy", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "description": "Dokładna nazwa kategorii, np. Włosy", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Produkty", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } } } } }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "summary": "Jeden produkt",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Produkt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/orders": {
      "get": {
        "summary": "Zamówienia zalogowanego klienta",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "opoznienie", "in": "query", "description": "Dowolna wartość: odpowiedź przychodzi po 0,5–2 s (symulacja wolnego serwera)", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Zamówienia, od najnowszego", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Złóż zamówienie na jeden produkt",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderRequest" } } }
        },
        "responses": {
          "201": { "description": "Zamówienie złożone", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Brak towaru na stanie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "$ref": "#/components/responses/Maintenance" }
        }
      }
    },
    "/api/orders/{number}": {
      "get": {
        "summary": "Jedno zamówienie (własne; admin widzi wszystkie)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "string", "examples": ["ZAM-1001"] } }],
        "responses": {
          "200": { "description": "Zamówienie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/account/address": {
      "get": {
        "summary": "Adres dostawy zalogowanego klienta",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Adres", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Address" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Zmień adres dostawy",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Address" } } }
        },
        "responses": {
          "200": { "description": "Zapisany adres", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Address" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/admin/orders": {
      "get": {
        "summary": "Wszystkie zamówienia (admin)",
        "x-role": "admin",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "q", "in": "query", "description": "Fragment numeru, loginu klienta albo nazwy produktu", "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Zamówienia", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/orders/{number}/cancel": {
      "post": {
        "summary": "Anuluj zamówienie (admin)",
        "x-role": "admin",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "string", "examples": ["ZAM-1003"] } }],
        "responses": {
          "200": { "description": "Anulowane zamówienie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Zamówienie jest już anulowane", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/settings/maintenance": {
      "get": {
        "summary": "Czy sklep jest w trybie konserwacji",
        "security": [],
        "responses": {
          "200": { "description": "Stan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Maintenance" } } } }
        }
      },
      "put": {
        "summary": "Włącz albo wyłącz tryb konserwacji (admin)",
        "x-role": "admin",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Maintenance" } } }
        },
        "responses": {
          "200": { "description": "Nowy stan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Maintenance" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/orders/{number}/invoice": {
      "get": {
        "summary": "Faktura do zamówienia na firmę (własnego; admin widzi wszystkie)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "string", "examples": ["ZAM-1007"] } }],
        "responses": {
          "200": { "description": "Dane faktury", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceDocument" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "summary": "Katalog: produkty z ceną promocyjną (jak kafelki na stronie głównej)",
        "security": [],
        "parameters": [
          { "name": "q", "in": "query", "description": "Fragment nazwy", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "description": "Dokładna nazwa kategorii", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "description": "Kolejność; bez parametru: kategoria i nazwa", "schema": { "type": "string", "enum": ["cena", "cena-malejaco", "nazwa"] } }
        ],
        "responses": {
          "200": { "description": "Produkty", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogProduct" } } } } },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/catalog/{id}": {
      "get": {
        "summary": "Karta produktu: cena promocyjna, opis, dostępność",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Produkt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogProduct" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/cart": {
      "get": {
        "summary": "Koszyk zalogowanego klienta (ceny po promocji i po kodzie rabatowym)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Koszyk", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cart" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "summary": "Opróżnij koszyk (także kod rabatowy)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Pusty koszyk", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cart" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "summary": "Dodaj produkt do koszyka",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartItemRequest" } } } },
        "responses": {
          "201": { "description": "Koszyk po dodaniu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cart" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Brak towaru na stanie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/cart/discount": {
      "post": {
        "summary": "Zastosuj kod rabatowy",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiscountRequest" } } } },
        "responses": {
          "200": { "description": "Koszyk z rabatem", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cart" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "summary": "Usuń kod rabatowy",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Koszyk bez rabatu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cart" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/cart/checkout": {
      "post": {
        "summary": "Złóż zamówienie z koszyka (jedno zamówienie na pozycję); z polem invoice na firmę",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutRequest" } } } },
        "responses": {
          "201": { "description": "Złożone zamówienia", "content": { "application/json": { "schema": { "type": "object", "properties": { "orders": { "type": "array", "items": { "$ref": "#/components/schemas/OrderDetails" } } } } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "description": "Koszyk jest pusty", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/business-orders": {
      "post": {
        "summary": "Zamówienie na firmę na jeden produkt (do 1000 sztuk), z fakturą",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BusinessOrderRequest" } } } },
        "responses": {
          "201": { "description": "Zamówienie złożone", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDetails" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Brak towaru na stanie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/account/addresses": {
      "get": {
        "summary": "Adresy w profilu (id 0 = adres główny z /api/account/address)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Adresy", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileAddress" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Dodaj adres do profilu",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewProfileAddress" } } } },
        "responses": {
          "201": { "description": "Dodany adres", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileAddress" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/account/addresses/{id}": {
      "delete": {
        "summary": "Usuń dodatkowy adres (adresu głównego, id 0, nie można)",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Adresy po usunięciu", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileAddress" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Adresu głównego nie można usunąć", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/account/addresses/{id}/default": {
      "put": {
        "summary": "Ustaw adres domyślny",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Adresy po zmianie", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileAddress" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/orders/{number}/status": {
      "put": {
        "summary": "Zmień status zamówienia (admin): Nowe → Opłacone → Wysłane, o jeden krok",
        "x-role": "admin",
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "string", "examples": ["ZAM-1007"] } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusRequest" } } } },
        "responses": {
          "200": { "description": "Zamówienie po zmianie", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Niedozwolona zmiana statusu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/promocja": {
      "get": {
        "summary": "Promocja Czarny Piątek: data startu, odliczanie i tekst banera",
        "security": [],
        "parameters": [
          { "name": "X-Namssor-Teraz", "in": "header", "description": "Data RRRR-MM-DD, którą aplikacja uzna za dzisiejszą tylko w tym żądaniu (do testów)", "schema": { "type": "string", "examples": ["2026-11-20"] } }
        ],
        "responses": {
          "200": { "description": "Stan promocji", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "start": { "type": "string", "examples": ["2026-11-27"] }, "today": { "type": "string" },
            "days_left": { "type": "integer" }, "message": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Wersja aplikacji (zmienna APP_VERSION; domyślnie main)",
        "security": [],
        "responses": {
          "200": { "description": "Wersja", "content": { "application/json": { "schema": { "type": "object", "properties": { "version": { "type": "string", "examples": ["main"] } } } } } }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "Ten dokument (OpenAPI 3.1)",
        "security": [],
        "responses": { "200": { "description": "Opis API", "content": { "application/json": {} } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Token z POST /api/login" },
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "sid", "description": "Ciasteczko ustawiane przy logowaniu" }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["login", "password"],
        "properties": { "login": { "type": "string", "examples": ["user"] }, "password": { "type": "string", "examples": ["user123"] } }
      },
      "LoginResponse": {
        "type": "object",
        "properties": { "token": { "type": "string" }, "user": { "$ref": "#/components/schemas/User" } }
      },
      "User": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "login": { "type": "string" }, "role": { "type": "string", "enum": ["user", "admin"] } }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price_cents": { "type": "integer", "description": "Cena w groszach" },
          "stock": { "type": "integer", "description": "Stan magazynu; 0 = niedostępny" }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": ["product_id"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1 },
          "qty": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "number": { "type": "string", "examples": ["ZAM-1001"] },
          "qty": { "type": "integer" },
          "status": { "type": "string", "enum": ["new", "paid", "shipped", "cancelled"] },
          "created_at": { "type": "string", "examples": ["2026-10-01 10:15"] },
          "product_id": { "type": "integer" },
          "product": { "type": "string" },
          "total_cents": { "type": "integer" },
          "customer": { "type": "string", "description": "Login klienta" }
        }
      },
      "CatalogProduct": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price_cents": { "type": "integer", "description": "Cena regularna w groszach" },
          "promo_percent": { "type": "integer", "description": "Rabat promocyjny w procentach; 0 = bez promocji" },
          "promo_price_cents": { "type": "integer", "description": "Cena po promocji (równa price_cents, gdy brak promocji)" },
          "available": { "type": "boolean" },
          "stock": { "type": "integer", "description": "Tylko w /api/catalog/{id}" },
          "description": { "type": "string", "description": "Tylko w /api/catalog/{id}" },
          "url": { "type": "string", "examples": ["/produkt/5"] }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "type": "object", "properties": {
            "id": { "type": "integer" }, "product_id": { "type": "integer" }, "name": { "type": "string" }, "qty": { "type": "integer" },
            "unit_price_cents": { "type": "integer", "description": "Cena za sztukę po promocji, przed kodem rabatowym" },
            "total_cents": { "type": "integer" } } } },
          "subtotal_cents": { "type": "integer", "description": "Suma przed kodem rabatowym" },
          "discount": { "type": ["object", "null"], "properties": {
            "code": { "type": ["string", "null"] }, "valid": { "type": "boolean" }, "message": { "type": "string" }, "amount_cents": { "type": "integer" } } },
          "total_cents": { "type": "integer", "description": "Do zapłaty" }
        }
      },
      "CartItemRequest": {
        "type": "object",
        "required": ["product_id"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1 },
          "qty": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 }
        }
      },
      "DiscountRequest": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "examples": ["CZARNY20"] } }
      },
      "Invoice": {
        "type": "object",
        "required": ["nip", "company"],
        "properties": {
          "nip": { "type": "string", "description": "10 cyfr z poprawną sumą kontrolną; myślniki i spacje dozwolone", "examples": ["2412241228"] },
          "company": { "type": "string", "examples": ["Biuro Mikołaja"] }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "properties": { "invoice": { "$ref": "#/components/schemas/Invoice" } }
      },
      "BusinessOrderRequest": {
        "type": "object",
        "required": ["product_id", "nip", "company"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1, "examples": [21] },
          "qty": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
          "nip": { "type": "string", "examples": ["2412241228"] },
          "company": { "type": "string", "examples": ["Biuro Mikołaja"] }
        }
      },
      "OrderDetails": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "paid", "shipped", "cancelled"] },
          "created_at": { "type": "string" },
          "product_id": { "type": "integer" },
          "product": { "type": "string" },
          "qty": { "type": "integer" },
          "unit_price_cents": { "type": "integer" },
          "total_cents": { "type": "integer" },
          "discount_code": { "type": ["string", "null"] },
          "invoice": { "type": ["object", "null"], "properties": { "nip": { "type": "string" }, "company": { "type": "string" } } }
        }
      },
      "InvoiceDocument": {
        "type": "object",
        "properties": {
          "invoice_number": { "type": "string", "examples": ["FV/2026/ZAM-1007"] },
          "order_number": { "type": "string" },
          "issue_date": { "type": "string" },
          "seller": { "type": "object", "properties": { "name": { "type": "string" }, "address": { "type": "string" }, "nip": { "type": "string" } } },
          "buyer": { "type": "object", "properties": { "name": { "type": "string" }, "nip": { "type": "string" } } },
          "items": { "type": "array", "items": { "type": "object", "properties": {
            "name": { "type": "string" }, "qty": { "type": "integer" }, "unit_price_cents": { "type": "integer" }, "total_cents": { "type": "integer" } } } },
          "total_cents": { "type": "integer" }
        }
      },
      "ProfileAddress": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "0 = adres główny" },
          "name": { "type": "string", "examples": ["Praca"] },
          "street": { "type": "string" },
          "postal_code": { "type": "string" },
          "city": { "type": "string" },
          "phone": { "type": "string" },
          "default": { "type": "boolean" }
        }
      },
      "NewProfileAddress": {
        "type": "object",
        "required": ["name", "street", "postal_code", "city", "phone"],
        "properties": {
          "name": { "type": "string", "maxLength": 40, "examples": ["Praca"] },
          "street": { "type": "string", "maxLength": 100 },
          "postal_code": { "type": "string", "pattern": "^\\d{2}-\\d{3}$" },
          "city": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "StatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["new", "paid", "shipped"] } }
      },
      "Address": {
        "type": "object",
        "required": ["street", "postal_code", "city", "phone"],
        "properties": {
          "street": { "type": "string", "maxLength": 100 },
          "postal_code": { "type": "string", "pattern": "^\\d{2}-\\d{3}$", "examples": ["00-001"] },
          "city": { "type": "string" },
          "phone": { "type": "string", "description": "9 cyfr, opcjonalnie z +48; spacje dozwolone", "examples": ["500 100 200"] }
        }
      },
      "Maintenance": {
        "type": "object",
        "required": ["enabled"],
        "properties": { "enabled": { "type": "boolean" } }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "examples": ["Błędne dane"] },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": { "description": "Błędne dane", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
      "Unauthorized": { "description": "Wymagane logowanie albo złe dane logowania", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Brak uprawnień (zła rola)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Nie znaleziono", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Maintenance": { "description": "Sklep w trybie konserwacji", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
