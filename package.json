{
  "name": "e2e-podstawy-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikacja szkoleniowa Namssor (fikcyjna drogeria) i przykładowe testy Playwright",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "check:node": "node scripts/check-node.mjs",
    "start": "node --disable-warning=ExperimentalWarning app/server.mjs",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
